# Database Configuration
POSTGRES_DB=nutritionist_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# JVM Options
JAVA_OPTS=-Xmx512m -Xms256m

# Database URL (cuando la app corre en Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nutritionist_db

# Database URL (cuando la app corre localmente y DB en Docker)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nutritionist_db
